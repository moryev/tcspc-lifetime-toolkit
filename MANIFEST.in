include LICENSE CITATION.cff CHANGELOG.md README.md AGENTS.md pyproject.toml
include .ruff-format-baseline.json
include .gitignore .github/workflows/ci.yml
recursive-include src *.py
recursive-include tests *.py *.json
recursive-include examples *.py *.md
recursive-include scripts *.py
recursive-include configs *.json
recursive-include docs *.md *.png *.csv *.json
recursive-include notebooks *.ipynb
recursive-include data/examples *.csv *.md
recursive-include data/reference *.json *.md
prune data/generated
prune build
prune dist
global-exclude __pycache__ *.py[cod] .ipynb_checkpoints
